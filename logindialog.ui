  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: #0b1118;
}

QLabel {
    color: #c9d1d9; /* Ana sayfa uyumlu açık gri */
    font-weight: bold;
    font-size: 12px;
}

/* Şifre ve Kullanıcı Adı Kutuları */
QLineEdit {
    background-color: #161b22;
    color: #e6edf3; /* Yeşil yerine ana sayfa beyazı */
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 6px;
    font-size: 13px;
    max-height: 25px; /* Kutuların kalınlaşmasını engeller */
}
QLineEdit:focus {
    border: 1px solid #1f6feb; /* Tıklanınca ana sayfadaki gibi mavi parlar */
}

/* Standart Butonlar (Kayıt Ol, Şifre Değiştir) */
QPushButton {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 8px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #30363d;
    color: #ffffff;
    border-color: #8b949e;
}

/* Giriş Butonu Özel Tasarım (Ana Sayfa Mavi Vurgusu) */
QPushButton#btnLogin {
    background-color: #1f6feb; 
    color: #ffffff;
    border: none;
}
QPushButton#btnLogin:hover {
    background-color: #388bfd;
}

/* Hata/Uyarı Mesajı Rengi */
QLabel#lblStatus {
    color: #ff5252;
    font-style: italic;
    font-weight: bold;
}</string>
