  <property name="styleSheet">
   <string notr="true">/* Ana Arka Plan */
QMainWindow {
    background-color: #0b1320; 
}

/* Tüm Başlıklar (QLabel) */
QLabel {
    color: #a9b7c6; /* Göz yormayan açık gri/mavi tonu */
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;;
    font-size: 12px;
}

/* Tüm Dijital Göstergeler (QLCDNumber) */
QLCDNumber {
    background-color: #040812; /* Panelin içine gömülü hissi veren çok koyu renk */
    color: #00ff00; /* Neon yeşili rakamlar */
    border: 1px solid #1a273a; /* İncecik, şık bir çerçeve */
    border-radius: 4px; /* Hafif yumuşatılmış köşeler */
}

/* Progress Bar Ana Hattı */
QProgressBar {
    border: 1px solid #1a273a;
    background-color: #040812;
    text-align: center;
    color: #a9b7c6;
}

/* Progress Bar İçindeki Dolan Kısım */
QProgressBar::chunk {
    background-color: #00ff00; /* Neon yeşili dijital dolgu */
    width: 8px; /* Kesik kesik askeri bar görünümü verir */
    margin: 1px;
}</string>
