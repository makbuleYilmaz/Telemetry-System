       <property name="styleSheet">
        <string notr="true">QWidget {
    background-color: #0b1118;
    color: #e6edf3;
    font-family: 'Segoe UI', 'Helvetica', sans-serif;
}

/* -------------------------------------------
   1. LOG EKRANI (TERMINAL) - BÜYÜTÜLDÜ VE MODERNLEŞTİRİLDÜ
--------------------------------------------- */
QPlainTextEdit {
    background-color: rgba(5, 8, 12, 0.8); /* Daha tok bir yarı saydam siyah */
    border: 1px solid #1c2a38;
    border-radius: 6px;
    color: #39ff14; /* Standart yeşil yerine daha parlak/modern neon yeşil */
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 13px; /* Yazılar büyütüldü (Eskisi 10px idi) */
    padding: 10px; /* Yazıların kenarlara yapışmasını engeller */
}

/* Log ekranının kaydırma çubuğunu (Scrollbar) incelt ve modernleştir */
QScrollBar:vertical {
    border: none;
    background: #0b1118;
    width: 10px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #1c2a38;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #30363d;
}

/* -------------------------------------------
   2. SENSÖR ETİKETLERİ VE BAŞLIKLAR
--------------------------------------------- */
QGroupBox {
    border: none;
    background: transparent;
    margin-top: 15px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    color: #58a6ff; /* Parlak teknoloji mavisi - neon yeşil ile çok şık bir kontrast yaratır */
    font-size: 15px; /* Eskisi 12px'di, ciddi oranda büyütüldü ve belirginleşti */
    font-weight: bold;
    letter-spacing: 1px; 
    text-transform: uppercase;
    padding-bottom: 5px; /* Yazının hemen altındaki elemanlara yapışmasını önler */
}

QLabel {
    color: #c9d1d9; 
    font-size: 12px; /* Yazılar 11'den 12'ye çekilip daha okunaklı yapıldı */
    font-weight: bold;
    background: transparent;
}

/* -------------------------------------------
   3. DİJİTAL GÖSTERGELER (LCD) VE BARLAR
--------------------------------------------- */
QLCDNumber {
    color: #00ff00; 
    background: transparent;
    border: none;
}

QProgressBar {
    border: 1px solid #1c2a38;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
    background-color: #05080c;
    font-weight: bold;
    font-size: 11px;
}
QProgressBar::chunk {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #00aa00, stop:1 #00ff00); /* Düz yeşil yerine estetik bir renk geçişi (Gradient) eklendi */
    border-radius: 3px;
    width: 6px;
    margin: 1px;
}

/* -------------------------------------------
   4. DİĞER BİLEŞENLER
--------------------------------------------- */
QTabWidget::pane { border: 1px solid #1c2a38; background: #0b1118; }
QTabBar::tab {
    background: #121c26; color: #8b949e; padding: 9px 22px;
    border: 1px solid #1c2a38; border-bottom: none;
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    margin-right: 3px; font-weight: bold;
}
QTabBar::tab:selected {
    background: #0b1118; color: #00ff00;
    border-top: 2px solid #00ff00; border-bottom: 2px solid #0b1118;
}
QTabBar::tab:hover { color: #ffffff; background: #16222f; }

QTableWidget, QTableView {
    background-color: #0d1117; color: #ffffff;
    gridline-color: #30363d; selection-background-color: #1f6feb;
}
QHeaderView::section {
    background-color: #161b22; color: #00ff00;
    font-weight: bold; border: 1px solid #30363d; padding: 4px;
}
QLineEdit, QComboBox {
    background-color: #161b22; color: #00ff00;
    border: 1px solid #30363d; border-radius: 3px; padding: 4px;
}

/* macOS TARZI ÜST BAR BUTONLARI */
#customTitleBar { background-color: #070B12; min-height: 30px; max-height: 30px; }
QPushButton#btnClose { background-color: #FF5F56; border-radius: 7px; min-width: 14px; max-width: 14px; min-height: 14px; max-height: 14px; border: none; margin: 4px; }
QPushButton#btnClose:hover { background-color: #E0443E; }
QPushButton#btnMin { background-color: #FFBD2E; border-radius: 7px; min-width: 14px; max-width: 14px; min-height: 14px; max-height: 14px; border: none; margin: 4px; }
QPushButton#btnMin:hover { background-color: #DDA127; }
QPushButton#btnMax { background-color: #27C93F; border-radius: 7px; min-width: 14px; max-width: 14px; min-height: 14px; max-height: 14px; border: none; margin: 4px; }
QPushButton#btnMax:hover { background-color: #1EA532; }

/* FİLTRELE VE DİĞER STANDART BUTONLARIN TEPKİLERİ */
QPushButton {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 6px 15px;
}
QPushButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
}
QPushButton:pressed {
    background-color: #1f6feb; /* Basılınca taktiksel mavi renge döner */
    padding-top: 8px; /* Yazıyı 2 piksel aşağı iterek &quot;çökme/basılma&quot; hissi yaratır */
    padding-bottom: 4px;
}</string>
